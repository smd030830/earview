    <string name="permission_notification">알림</string>
    <string name="permission_notification_reason">감지 중임을 화면 상단 고정 알림으로 보여 주고, 감지가 갑자기 멈추면 알려 드리기 위해 필요합니다.</string>
    <string name="permission_notification_allow">알림 허용</string>
